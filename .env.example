# MRPT PPA Publisher Docker Configuration
# Copy this file to .env and adjust values for your environment

# =============================================================================
# HOST DIRECTORY MAPPINGS
# =============================================================================

# GPG keys directory on host (must contain valid PPA signing keys)
# Default: /home/mrptppa/.gnupg
HOST_GPG_DIR=/home/mrptppa/.gnupg

# Dput configuration file on host
# Default: /home/mrptppa/.dput.cf
HOST_DPUT_CONFIG=/home/mrptppa/.dput.cf

# SSH keys directory on host (optional, for git operations)
# Default: /home/mrptppa/.ssh
HOST_SSH_DIR=/home/mrptppa/.ssh

# =============================================================================
# ENVIRONMENT VARIABLES
# =============================================================================

# Email address for cron job notifications
MAILTO=jlblanco@ual.es

# PPA URL for package uploads
PPA_URL=ppa:joseluisblancoc/mrpt

# Timezone for container (affects log timestamps and cron scheduling)
# Find your timezone: timedatectl list-timezones
TZ=Europe/Madrid

# =============================================================================
# DOCKER RESOURCE LIMITS (optional, uncomment to use)
# =============================================================================

# Maximum CPU cores to use
# DOCKER_CPU_LIMIT=4.0

# Maximum memory to use (in GB)
# DOCKER_MEMORY_LIMIT=8G

# =============================================================================
# ADVANCED OPTIONS (usually don't need to change)
# =============================================================================

# Container name
# CONTAINER_NAME=mrpt-ppa-publisher

# Image tag
# IMAGE_TAG=latest